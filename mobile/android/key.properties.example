## Android Release Signing Configuration
##
## 1. Generate a keystore (run once, keep the .jks file safe):
##
##    keytool -genkey -v \
##      -keystore ~/distil-smart-home-upload.jks \
##      -keyalg RSA -keysize 2048 -validity 10000 \
##      -alias distil
##
## 2. Copy this file to key.properties (it is git-ignored):
##
##    cp key.properties.example key.properties
##
## 3. Fill in the values below:

storePassword=<your-keystore-password>
keyPassword=<your-key-password>
keyAlias=distil
storeFile=<path-to-your-keystore, e.g. /Users/you/distil-smart-home-upload.jks>
